{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "destination": "https://www.oneummahquranlearning.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hussain-web-2.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://hussain-web-2.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://hussain-web-2.onrender.com/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
